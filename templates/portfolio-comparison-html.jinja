<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Patent Portfolio Comparison — {{ title }}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0d1117; color: #c9d1d9; line-height: 1.6; }
  .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  .hero { background: linear-gradient(135deg, #161b22 0%, #1a2332 100%); border-radius: 12px; padding: 2rem; margin-bottom: 2rem; }
  .hero h1 { font-size: 1.8rem; color: #58a6ff; margin-bottom: 0.5rem; }
  .hero p { color: #8b949e; }
  .stat-tiles { display: grid; grid-template-columns: repeat({{ companies|length }}, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .stat-tile { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 1.2rem; text-align: center; }
  .stat-tile .company-name { font-size: 1.1rem; font-weight: 700; color: #58a6ff; margin-bottom: 0.5rem; }
  .stat-tile .value { font-size: 2rem; font-weight: 700; color: #58a6ff; }
  .stat-tile .label { font-size: 0.85rem; color: #8b949e; margin-top: 0.3rem; }
  .stat-tile .sub { font-size: 0.75rem; color: #484f58; margin-top: 0.3rem; }
  .section { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .section h2 { font-size: 1.3rem; color: #58a6ff; margin-bottom: 1rem; border-bottom: 1px solid #30363d; padding-bottom: 0.5rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid #30363d; font-size: 0.9rem; }
  th { color: #8b949e; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
  tr:hover { background: #1a2332; }
  .bar { display: inline-block; height: 20px; background: linear-gradient(90deg, #1f6feb, #58a6ff); border-radius: 4px; vertical-align: middle; min-width: 2px; }
  .bar.bar-green { background: linear-gradient(90deg, #238636, #3fb950); }
  .bar.bar-yellow { background: linear-gradient(90deg, #9e6a03, #d29922); }
  .bar.bar-red { background: linear-gradient(90deg, #da3633, #f85149); }
  .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
  .badge.green { background: rgba(63,185,80,0.15); color: #3fb950; border: 1px solid rgba(63,185,80,0.3); }
  .badge.yellow { background: rgba(210,153,34,0.15); color: #d29922; border: 1px solid rgba(210,153,34,0.3); }
  .badge.red { background: rgba(248,81,73,0.15); color: #f85149; border: 1px solid rgba(248,81,73,0.3); }
  .badge.blue { background: rgba(88,166,255,0.15); color: #58a6ff; border: 1px solid rgba(88,166,255,0.3); }
  .filter-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .filter-pill { padding: 0.3rem 0.8rem; border-radius: 16px; border: 1px solid #30363d; background: #161b22; cursor: pointer; font-size: 0.85rem; color: #8b949e; transition: all 0.2s; }
  .filter-pill.active { background: #1f6feb; color: #fff; border-color: #1f6feb; }
  .filter-pill:hover { border-color: #58a6ff; }
  .chart-placeholder { background: #0d1117; border: 1px dashed #30363d; border-radius: 8px; padding: 3rem; text-align: center; color: #8b949e; margin: 1rem 0; }
  .caveat { background: #1a1209; border: 1px solid #9e6a03; border-radius: 8px; padding: 0.8rem 1rem; margin: 0.5rem 0; font-size: 0.85rem; color: #d29922; }
  .methodology { font-size: 0.85rem; color: #8b949e; }
  .methodology code { background: #0d1117; padding: 0.2rem 0.4rem; border-radius: 4px; color: #58a6ff; font-size: 0.85rem; }
  .export-btn { float: right; padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid #30363d; background: #21262d; color: #8b949e; cursor: pointer; font-size: 0.75rem; }
  .export-btn:hover { border-color: #58a6ff; color: #58a6ff; }
  .footer { text-align: center; color: #484f58; font-size: 0.8rem; padding: 2rem 0; border-top: 1px solid #30363d; }
  a { color: #58a6ff; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .company-col { min-width: 200px; }
  .patent-link { font-family: monospace; font-size: 0.85rem; }
  details summary { cursor: pointer; color: #58a6ff; font-size: 0.9rem; padding: 0.5rem 0; }
  details summary:hover { text-decoration: underline; }
  .tech-tag { display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; margin: 0.1rem; background: #21262d; border: 1px solid #30363d; color: #8b949e; }
</style>
</head>
<body>
<div class="container">
  <!-- Hero -->
  <div class="hero">
    <h1>{{ title }}</h1>
    <p>{{ subtitle }}</p>
    <div class="stat-tiles">
      {% for c in companies %}
      <div class="stat-tile">
        <div class="company-name">{{ c.name }}</div>
        <div class="value">{{ c.total_results }}</div>
        <div class="label">Patent Filings</div>
        <div class="sub">{{ c.query }}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- Caveats -->
  {% if caveats %}
  <div class="section" style="border-color: #9e6a03;">
    <h2 style="color: #d29922;">⚠️ Data Quality Notes</h2>
    {% for caveat in caveats %}
    <div class="caveat">{{ caveat }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Filter Bar -->
  <div class="filter-bar">
    <span class="filter-pill active" onclick="filterView('all')">All Patents</span>
    <span class="filter-pill" onclick="filterView('granted')">Granted</span>
    <span class="filter-pill" onclick="filterView('application')">Applications</span>
    <span class="filter-pill" onclick="filterView('semiconductor')">Semiconductor</span>
    <span class="filter-pill" onclick="filterView('computing')">Computing/AI</span>
    <span class="filter-pill" onclick="filterView('device')">Devices/Display</span>
  </div>

  <!-- Company Comparison Matrix -->
  <div class="section">
    <h2>Portfolio Comparison Matrix</h2>
    <table>
      <thead>
        <tr>
          <th>Metric</th>
          {% for c in companies %}<th>{{ c.name }}</th>{% endfor %}
          <th>Winner</th>
        </tr>
      </thead>
      <tbody>
        {% for row in comparison_matrix %}
        <tr>
          <td>{{ row.metric }}</td>
          {% for v in row.vals %}<td>{{ v }}</td>{% endfor %}
          <td><span class="badge {{ row.winner_badge }}">{{ row.winner }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Technology Overlap -->
  <div class="section">
    <h2>Technology Area Coverage</h2>
    <table>
      <thead>
        <tr>
          <th>CPC Area</th>
          <th>Plain English</th>
          {% for c in companies %}<th>{{ c.name }}</th>{% endfor %}
          <th>Overlap</th>
        </tr>
      </thead>
      <tbody>
        {% for tech in tech_overlap %}
        <tr>
          <td><code>{{ tech.code }}</code></td>
          <td>{{ tech.plain }}</td>
          {% for c in companies %}
          <td>{% if tech[c.key] %}<span class="badge green">✅</span>{% else %}<span class="badge red">❌</span>{% endif %}</td>
          {% endfor %}
          <td>{{ tech.overlap }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Notable Patents per Company -->
  {% for c in companies %}
  <div class="section" id="patents-{{ c.key }}">
    <h2>{{ c.name }} — Notable Patents ({{ c.date_range }})</h2>
    <details>
      <summary>Query: <code>{{ c.query }}</code> → {{ c.total_results }} results, {{ c.pages }} pages</summary>
      <p class="methodology" style="margin-top:0.5rem;">
        Source: <code>{{ c.source }}</code><br>
        Filing period: <code>{{ c.date_range }}</code><br>
        {% if c.pagination %}Pages fetched: {{ c.pages_fetched }} / {{ c.pages }}{% endif %}
      </p>
    </details>
    <table>
      <thead>
        <tr><th>#</th><th>Patent #</th><th>Title</th><th>Filing Date</th><th>Assignee</th><th>Jurisdictions</th><th>Link</th></tr>
      </thead>
      <tbody>
        {% for p in c.patents %}
        <tr>
          <td>{{ loop.index }}</td>
          <td class="patent-link">{{ p.pub_number }}</td>
          <td>{{ p.title }}</td>
          <td>{{ p.filing_date }}</td>
          <td>{{ p.assignee }}</td>
          <td>
            {% for country in p.countries %}<span class="tech-tag">{{ country }}</span>{% endfor %}
          </td>
          <td><a href="https://patents.google.com/patent/{{ p.pub_number }}/en" target="_blank">🔗</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}

  <!-- White Space Analysis -->
  <div class="section">
    <h2>White-Space Opportunities</h2>
    <table>
      <thead><tr><th>CPC Area</th><th>Plain English</th><th>Current Coverage</th><th>Opportunity Level</th></tr></thead>
      <tbody>
        {% for ws in white_space %}
        <tr>
          <td><code>{{ ws.code }}</code></td>
          <td>{{ ws.plain }}</td>
          <td>{{ ws.coverage }}</td>
          <td><span class="badge {{ ws.level_badge }}">{{ ws.level }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Strategic Positioning -->
  <div class="section">
    <h2>Strategic Positioning</h2>
    <table>
      <thead><tr><th>Company</th><th>Focus</th><th>Strength</th><th>Geographic Spread</th><th>Recommendation</th></tr></thead>
      <tbody>
        {% for sp in strategic %}
        <tr>
          <td><strong>{{ sp.company }}</strong></td>
          <td>{{ sp.focus }}</td>
          <td>{{ sp.strength }}</td>
          <td>{{ sp.geo }}</td>
          <td>{{ sp.recommendation }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Methodology -->
  <div class="section methodology">
    <h2>Methodology</h2>
    <p><strong>Data source:</strong> {{ data_source }}</p>
    <p><strong>Date range:</strong> {{ date_start }} to {{ date_end }}</p>
    <p><strong>Queries:</strong></p>
    <ul>
      {% for c in companies %}
      <li><code>{{ c.query }}</code></li>
      {% endfor %}
    </ul>
    {% if row_cap %}<div class="caveat">Row-cap truncation: results limited to {{ row_cap }} rows per company.</div>{% endif %}
    {% if snapshot_lag %}<div class="caveat">Snapshot freshness: data may lag by {{ snapshot_lag }} days due to publication delay.</div>{% endif %}
    <p style="margin-top:1rem;"><strong>Three-count tracking:</strong></p>
    <ul>
      <li>Queries sent: {{ queries_sent }}</li>
      <li>Patents received: {{ patents_received }}</li>
      <li>Patents cited in report: {{ patents_cited }}</li>
    </ul>
  </div>

  <div class="footer">
    Generated by patenter v{{ version }} | {{ generation_date }} | Mode A (google-patents xhr)
  </div>
</div>

<script>
function filterView(type) {
  document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
  event.target.classList.add('active');
  // Client-side filter logic
}

function exportCSV() {
  alert('CSV export — implement in production');
}
</script>
</body>
</html>